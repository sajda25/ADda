# =============================================================================
# ADda — environment configuration
# Copy to apps/web/.env.local for local development.
# Never commit real secrets or deployer private keys.
# =============================================================================

# --- Required for local development (Phase 2+) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adda?schema=public"

# --- Demo / local mode ---
# When true, the app uses seeded demo data and does not require wallet for exploration.
NEXT_PUBLIC_DEMO_MODE="true"
NEXT_PUBLIC_DEMO_DISTRICT_LABEL="College Street Demo District, Kolkata (Illustrative)"

# --- Monad Testnet (Phase 7+) ---
NEXT_PUBLIC_CHAIN_ID="10143"
NEXT_PUBLIC_MONAD_RPC="https://testnet-rpc.monad.xyz"
NEXT_PUBLIC_MONAD_EXPLORER="https://testnet.monadexplorer.com"

# --- Privy wallet onboarding (Phase 7+) ---
# Required only for wallet-connected actions (publish on-chain, treasury).
NEXT_PUBLIC_PRIVY_APP_ID=""

# --- Deployed contract addresses (fill after Foundry deploy) ---
NEXT_PUBLIC_MEMORY_REGISTRY_ADDRESS=""
NEXT_PUBLIC_STREET_MURAL_EPOCH_ADDRESS=""
NEXT_PUBLIC_NEIGHBORHOOD_TREASURY_ADDRESS=""

# --- Server-only (never use NEXT_PUBLIC_ prefix) ---
# Used by Foundry deploy + server-side Monad registerMemory — keep out of the web bundle.
# DEPLOYER_PRIVATE_KEY=""
# PRIVATE_KEY=""
